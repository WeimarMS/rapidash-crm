# ============================================================
# RapiDash CRM — Variables de entorno (plantilla)
# Copiar a .env.local y completar con valores reales.
# ============================================================

# ── Frontend (Vite expone solo las que empiezan con VITE_) ──
VITE_SUPABASE_URL=https://vshgbwacnordnqzffcif.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_publica

# ── Servidor / Netlify Functions (SIN prefijo VITE_) ────────
# Estas NO se exponen al bundle del frontend. La service role
# key vive solo aquí y en Netlify → Environment variables.
# Para `netlify dev` local, copialas también a un archivo .env.
SUPABASE_URL=https://vshgbwacnordnqzffcif.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_secreta

# Opcional: a dónde redirige el link de invitación por email.
# SITE_INVITE_REDIRECT=https://rapidash-crm.netlify.app/login
